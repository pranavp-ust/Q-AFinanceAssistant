# ---- LLM provider: openai | gemini | none ----
# "none" runs the whole workflow offline using each agent's rule-based fallback
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional cheaper/backup model used when the primary model keeps failing
OPENAI_FALLBACK_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Embeddings: local | openai | gemini ----
# "local" = Chroma's built-in all-MiniLM-L6-v2 (free, runs on CPU)
EMBEDDING_PROVIDER=local

# ---- Workflow tuning ----
RETRIEVAL_TOP_K=6
# Chroma cosine distance above which a chunk is considered irrelevant
MAX_RELEVANT_DISTANCE=0.75
# Answers whose validation confidence is below this go to a human reviewer
REVIEW_CONFIDENCE_THRESHOLD=0.6
# KPI text-vs-ledger difference (%) that triggers human review
KPI_DISCREPANCY_PCT=1.0
LLM_MAX_RETRIES=3
MEMORY_WINDOW_TURNS=6
